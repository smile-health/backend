# Service variables
PORT=5001
LOG_LEVEL=info  
LOG_CALLER=false
APP_DEBUG=false
APP_BASE_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smile_auth
DB_CONNECTION_LIMIT=10

# SMTP Configuration
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=SMILE Platform
MAIL_FROM_ADDRESS=noreply@smile-health.com

# Password Reset
RESET_TOKEN_EXPIRY_MS=3600000

# Keycloak variables
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=smile
KEYCLOAK_CLIENT_ID=smile
KEYCLOAK_CLIENT_SECRET=
REALM_SYSUSER_NAME=sysuser
REALM_SYSUSER_PASS=smileforever

DOC_URL=/doc

