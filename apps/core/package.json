{
  "name": "@smile/smile-core",
  "type": "module",
  "version": "2.0.0",
  "main": "index.ts",
  "keywords": [],
  "author": "Muhammad Alif",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm link @smile/lib && bun --watch ./src/server.ts",
    "start": "node ./dist/server.js",
    "build": "npx kysely-codegen --out-file ./src/common/infrastructure/database/types/db.d.ts",
    "build:notification": "dotenvx run --env .env -- sh -c 'npx kysely-codegen --dialect mysql --url $NOTIFICATION_DATABASE_URL --out-file ./src/common/infrastructure/database/types/notification.d.ts'",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "npx prettier . --write",
    "format:all": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|jsx|tsx)\"",
    "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|jsx|tsx)\"",
    "db:make": "kysely migrate:make",
    "db:migrate": "bun src/cli.ts run-migrate",
    "db:rollback": "bun src/cli.ts run-rollback",
    "db:seed": "kysely seed:run",
    "db:seed:make": "kysely seed:make",
    "email:preview": "email preview ./src/app",
    "scheduler:run:dev": "tsx watch --clear-screen=false src/scheduler.ts",
    "scheduler:run": "node ./dist/scheduler.js",
    "worker": "bun src/cli.ts run-worker",
    "test": "dotenvx run -f .env.test -- vitest run --reporter=verbose",
    "test:mocha": "mocha --require ts-node/register --require tsconfig-paths/register --loader=ts-node/esm 'src/tests/**/*.test.ts'",
    "test:api": "mocha --require ts-node/register --require tsconfig-paths/register --loader=ts-node/esm 'src/tests/api/**/*.test.ts'",
    "test:watch": "mocha --watch --require ts-node/register --require tsconfig-paths/register --loader=ts-node/esm 'src/tests/**/*.test.ts'",
    "migrate-keycloak": "bun src/cli.ts migrate-users-keycloak",
    "cron:daily-recap-notif": "bun src/cli.ts recap-notif-email",
    "cron:asset-maintenance-reminder": "bun ./src/cli.ts asset-maintenance-reminder",
    "cron:asset-calibration-reminder": "bun ./src/cli.ts asset-calibration-reminder",
    "cron:asset-warranty-reminder": "bun ./src/cli.ts asset-warranty-reminder",
    "cron:asik-aggregate-sync": "bun ./src/cli.ts asik-aggregate-sync"
  },
  "description": "",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@faker-js/faker": "^9.9.0",
    "@hono/node-server": "^1.19.5",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.19.10",
    "@hono/zod-validator": "^0.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@smile/lib": "^1.0.238",
    "@types/bun": "^1.2.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "amqp": "^0.2.7",
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bun": "^1.2.23",
    "commander": "^12.1.0",
    "elastic-apm-node": "^4.14.0",
    "es-toolkit": "^1.39.10",
    "exceljs": "^4.4.0",
    "hono": "^4.10.2",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "kysely": "^0.27.6",
    "kysely-ctl": "^0.18.0",
    "minio": "^7.1.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.15.1",
    "pino": "^9.13.1",
    "testcontainers": "^10.28.0",
    "uuid": "^11.1.0",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "xlsx-populate": "^1.21.0",
    "znv": "^0.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.8",
    "chai": "^4.5.0",
    "kysely-codegen": "^0.16.8",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
