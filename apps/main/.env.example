NODE_ENV=development
PORT=4002
TIMEOUT=60
LOG_MODE=development

APP_NAME=MyApp
APP_KEY=my-secret-key
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=mysql
DB_USER=user
DB_PORT=3306
DB_PASSWORD=password
DB_NAME=testdb

IMUN_DB_USER=root
IMUN_DB_PASSWORD=password
IMUN_DB_NAME=testdb
IMUN_DB_HOST=mysql
IMUN_DB_PORT=3308

LOGISTIK_DB_USER=root
LOGISTIK_DB_PASSWORD=password
LOGISTIK_DB_NAME=testdb
LOGISTIK_DB_HOST=mysql
LOGISTIK_DB_PORT=3308

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
ENABLE_CACHE=true
REDIS_TTL=300

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=b5c503d4fecda0
MAIL_FROM_NAME=myapp
MAIL_FROM_ADDRESS=myapp@example.com

OTLP_ENABLED=true
OTLP_ENDPOINT=http://localhost:4318
OTLP_PROTOCOL=http

CLICKHOUSE_DATABASE_URL=http://user:password@127.0.0.1:8123/dbname
DATAMART_DATABASE_URL=http://user:password@127.0.0.1:8123/dbname

# RisingWave Database (Optional - leave empty if not using RisingWave)
RISINGWAVE_DATABASE_URL=

ENCRYPT_KEY=
IV_KEY=

MINIO_ENDPOINT=0.0.0.0
MINIO_PORT=0000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=accesskey
MINIO_SECRET_KEY=secretkey

EXPORT_EXCEL_BATCH_SIZE=100000
EXPORT_EXCEL_BUCKET_NAME=bucketname
EXPORT_EXCEL_EXPIRES_DAYS=7

LIST_USE_CLICKHOUSE=true
STOCK_LIST_SOURCE=mysql
ENTITY_LIST_SOURCE=mysql
ORDER_LIST_SOURCE=mysql
