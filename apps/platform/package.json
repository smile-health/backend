{
  "name": "@smile/smile-platform",
  "type": "module",
  "version": "2.0.0",
  "main": "index.ts",
  "keywords": [],
  "author": "Muhammad Alif",
  "license": "ISC",
  "scripts": {
    "dev": "bun --watch ./src/server.ts",
    "start": "node ./dist/server.js",
    "build": "npx kysely-codegen --out-file ./src/common/infrastructure/database/types/db.d.ts",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "npx prettier . --write",
    "format:all": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|jsx|tsx)\"",
    "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|jsx|tsx)\"",
    "db:rollback": "kysely migrate:rollback --all",
    "email:preview": "email preview ./src/app",
    "scheduler:run:dev": "tsx watch --clear-screen=false src/scheduler.ts",
    "scheduler:run": "node ./dist/scheduler.js",
    "worker": "bun src/cli.ts run-worker",
    "test": "dotenvx run -f .env.test -- vitest run --reporter=verbose"
  },
  "description": "",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@faker-js/faker": "^9.9.0",
    "@hono/node-server": "^1.19.5",
    "@hono/zod-validator": "^0.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@smile/lib": "^1.0.235",
    "@types/bun": "^1.2.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "amqp": "^0.2.7",
    "amqplib": "^0.10.9",
    "bcrypt": "^5.1.1",
    "bun": "^1.2.23",
    "commander": "^12.1.0",
    "es-toolkit": "^1.39.10",
    "exceljs": "^4.4.0",
    "hono": "^4.10.2",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.6",
    "kysely-ctl": "^0.18.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.15.1",
    "pino": "^9.13.1",
    "testcontainers": "^10.28.0",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "xlsx-populate": "^1.21.0",
    "znv": "^0.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "kysely-codegen": "^0.16.8"
  }
}
