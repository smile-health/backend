{
  "name": "@smile/sync-service",
  "type": "module",
  "version": "1.0.0",
  "description": "Sync Engine to sync features of 5.0 to 3.0",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm link @smile-health/lib && bun --watch ./src/index.ts",
    "build": "npx kysely-codegen --out-file ./src/common/infrastructure/database/types/db.d.ts",
    "build:openapi": "npx orval",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "kysely migrate:latest",
    "migrate:all": "npm run migrate:activity; npm run migrate:entity; npm run migrate:user;npm run migrate:location;npm run migrate:material;npm run migrate:manufacture;npm run migrate:budget-source;",
    "migrate:activity": "bun ./src/cli.ts migrate-activity --reset  --limit 100 --programId 2;",
    "migrate:entity": "bun ./src/cli.ts migrate-entity-bulk --batchSize 10000 --programId 1",
    "migrate:user": "bun ./src/cli.ts migrate-user-bulk --batchSize 10000 --programId 2",
    "migrate:user-changelog": "bun ./src/cli.ts migrate-user-changelogs --programId 2",
    "migrate:location": "bun ./src/cli.ts migrate-location",
    "migrate:material": "bun ./src/cli.ts migrate-material --programId 2; bun ./src/cli.ts migrate-material --is-hierarchy --programId 2;",
    "migrate:manufacture": "bun ./src/cli.ts migrate-manufacture --reset --programId 2;",
    "migrate:budget-source": "bun ./src/cli.ts migrate-budget-source --reset --programId 2;",
    "migrate:migrate-assets": "bun ./src/cli.ts migrate-assets --programId 2",
    "migrate:ws:all": "npm run migrate:ws:manufacture;npm run migrate:ws:patient;npm run migrate:ws:trx-reason;npm run migrate:ws:reconciliation;",
    "migrate:ws:batch": "bun ./src/cli.ts migrate-ws-batch --programId 1; bun ./src/cli.ts migrate-ws-batch --programId 2;",
    "migrate:ws:patient": "bun ./src/cli.ts migrate-ws-patients --batchSize 1000 --programId 1; bun ./src/cli.ts migrate-ws-patients --batchSize 1000 --programId 2;",
    "migrate:ws:trx-reason": "bun ./src/cli.ts migrate-ws-transaction-reasons --reset --limit 100 --programId 1; bun ./src/cli.ts migrate-ws-transaction-reasons --reset  --limit 100 --programId 2;",
    "migrate:ws:entity": "bun ./src/cli.ts migrate-ws-entity --batchSize 4000 --programId 2; bun ./src/cli.ts migrate-ws-entity --batchSize 4000 --programId 1",
    "migrate:ws:material": "bun ./src/cli.ts migrate-ws-material --batchSize 10000 --programId 2; bun ./src/cli.ts migrate-ws-material --batchSize 10000 --programId 1",
    "migrate:ws:stock": "bun ./src/cli.ts migrate-ws-stock --batchSize 10000 --programId 1; bun ./src/cli.ts migrate-ws-stock --batchSize 10000 --programId 2;",
    "migrate:ws:order": "bun ./src/cli.ts migrate-ws-order --batchSize 10000 --programId 1;bun ./src/cli.ts migrate-ws-order --batchSize 10000 --programId 2;",
    "migrate:ws:transaction": "bun ./src/cli.ts migrate-ws-transactions --batchSize 10000 --programId 1; bun ./src/cli.ts migrate-ws-transactions --batchSize 10000 --programId 2",
    "migrate:ws:transaction:entity-activity-id": "bun ./src/cli.ts update-ws-transactions-entity-activity-id --batchSize 10000",
    "migrate:ws:stock-opname": "bun ./src/cli.ts migrate-ws-stock-opnames --batchSize 10000 --programId 2",
    "migrate:ws:reconciliation": "bun ./src/cli.ts migrate-ws-reconciliations --batchSize 10000 --programId 2;",
    "migrate:ws:event-report": "bun ./src/cli.ts migrate-ws-event-report --batchSize 10000 --programId 2",
    "migrate:ws:disposal-stocks": "bun ./src/cli.ts migrate-ws-disposal-stocks --batchSize 10000 --programId 2",
    "migrate:ws:disposal-shipments": "bun ./src/cli.ts migrate-ws-disposal-shipments --batchSize 10000 --programId 2",
    "migrate:ws:disposal-transactions": "bun ./src/cli.ts migrate-ws-disposal-transactions --batchSize 10000 --programId 2",
    "migrate:count": "bun ./src/cli.ts migrate-count",
    "migrate:update-status": "bun ./src/cli.ts update-status",
    "migrate:fix-created-by": "bun ./src/cli.ts fix-created-by --batchSize 1000 --programId 2"
  },
  "author": "Hafiz, Alif, Albian, Ibnu",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@founderpath/kysely-clickhouse": "^1.7.0",
    "@smile-health/lib": "^1.0.240",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "bun": "^1.2.23",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "hono": "^4.10.2",
    "ioredis": "^5.8.1",
    "kysely": "^0.27.6",
    "kysely-ctl": "^0.18.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mysql2": "^3.15.1",
    "orval": "7.6.0",
    "pluralize": "^8.0.0",
    "znv": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "kysely-codegen": "^0.16.8"
  }
}