{
  "name": "@smile/smile-warehouse",
  "type": "module",
  "version": "1.0.0",
  "main": "index.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm link @smile-health/lib && bun --watch ./src/server.ts",
    "start": "node ./dist/server.js",
    "build": "npx kysely-codegen --out-file ./src/common/infrastructure/database/types/db.d.ts",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "npx prettier . --write",
    "format:all": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|jsx|tsx)\"",
    "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|jsx|tsx)\"",
    "db:make": "pnpm kysely migrate:make",
    "db:migrate": "bun src/cli.ts run-migrate",
    "db:rollback": "bun src/cli.ts run-rollback",
    "view:make": "pnpm kysely seed:make",
    "view:migrate": "pnpm kysely seed:run && npm run build",
    "test": "dotenvx run -f .env.test -- vitest run",
    "cron:daily-download-export-reception": "bun src/cli.ts daily-download-export-reception",
    "cron:daily-download-export-stock-material": "bun src/cli.ts daily-download-export-stock-material",
    "cron:daily-download-export-consumption": "bun src/cli.ts daily-download-export-consumption",
    "cron:daily-download-export-discard": "bun src/cli.ts daily-download-export-discard",
    "cron:daily-download-export-expired-material": "bun src/cli.ts daily-download-export-expired-material",
    "cron:monthly-download-export-stock-availability": "bun src/cli.ts monthly-download-export-stock-availability",
    "cron:weekly-download-export-logger-monitoring": "bun src/cli.ts weekly-download-export-logger-monitoring",
    "cron:monthly-download-export-logger-monitoring": "bun src/cli.ts monthly-download-export-logger-monitoring"
  },
  "description": "",
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@faker-js/faker": "^10.6.0",
    "@founderpath/kysely-clickhouse": "^1.7.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@smile-health/lib": "^1.0.242",
    "@types/bun": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "amqp": "^0.2.7",
    "amqplib": "^2.3.0",
    "bcrypt": "^6.0.0",
    "bodybuilder": "^2.5.1",
    "bun": "^1.4.4",
    "commander": "^15.1.0",
    "es-toolkit": "^1.53.2",
    "hono": "^4.13.17",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.8",
    "kysely-ctl": "^0.22.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pluralize": "^8.0.0",
    "testcontainers": "^12.2.1",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "xlsx-populate": "^1.21.0",
    "xml2js": "^0.6.2",
    "znv": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/http-status-codes": "^1.2.0",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "@vitest/coverage-istanbul": "5.1.0",
    "axios": "^1.21.0",
    "chai": "^6.3.0",
    "es-module-lexer": "^3.0.4",
    "kysely-codegen": "^0.20.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1"
  }
}
