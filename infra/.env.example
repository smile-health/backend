MYSQL_ROOT_PASSWORD=password
MYSQL_USER=user
MYSQL_PASSWORD=password
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=password


# releases: https://www.postgresql.org/docs/release
POSTGRES_VERSION=16.4-alpine
POSTGRES_PASSWORD=secure_postgres_password

# Keycloak Details
# releases: https://github.com/keycloak/keycloak/releases
KC_VERSION=25.0.6
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=secure_keycloak_db_password
# KC Set-up & Realm Details
KC_HOSTNAME=http://localhost
KC_PORT=8081
KC_REALM_NAME=smile
KC_REALM_DISPLAY_NAME=SMILE 5.0
KC_CLIENT_NAME=smile
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak
REALM_SYSUSER_EMAIL=kc.sysuser@smile.com
REALM_SYSUSER_PASSWORD=smileforever
# SMILE App home URL details
SMILE_SERVER_HTTP_PORT=5000
SMILE_HOSTNAME=http://localhost
# Sample users in the realm
P_ADMIN_USERNAME=p_admin
P_ADMIN_PASSWORD=smile
APP_ADMIN_USERNAME=app_admin
APP_ADMIN_PASSWORD=smile
CUST_USERNAME=customer
CUST_PASSWORD=smile
# General settings
KC_LOG_LEVEL=INFO
# SMTP Settings
SMTP_HOST=192.168.1.7
SMTP_PORT=25
SMTP_USER_NAME=test
SMTP_USER_PASSWORD=test

