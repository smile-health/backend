{
  "name": "smile-monorepo",
  "private": true,
  "scripts": {
    "init": "pnpm install",
    "reinitiate": "rm -rf node_modules apps/core/node_modules apps/main/node_modules apps/3.0/main-api/node_modules apps/platform/node_modules apps/sync-service/node_modules apps/warehouse-service/node_modules packages/lib/node_modules && pnpm install",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:package": "npx sherif@latest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test --filter=@smile/smile-warehouse",
    "test:coverage": "turbo run test:coverage --filter=@smile/smile-warehouse"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "optionalDependencies": {
    "@oven/bun-windows-x64": "^1.4.4",
    "@oven/bun-windows-x64-baseline": "^1.4.4"
  },
  "workspaces": [
    "apps/*",
    "apps/3.0/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@smile-health/lib": "^1.0.235",
    "bun": "^1.4.4",
    "kysely-ctl": "^0.22.0",
    "pnpm": "^12.18.0"
  },
  "pnpm": {
    "overrides": {
      "@smile-health/lib": "@smile-health/lib",
      "nanoid@<3.3.8": ">=3.3.8",
      "esbuild": ">=0.25.0",
      "serialize-javascript@>=6.0.0 <6.0.2": ">=6.0.2",
      "vite@<=5.4.20": ">=5.4.21"
    }
  }
}
